rules_version = '2';

// Permissive rules for LOCAL DEV ONLY. The emulator uses these
// when started with `firebase emulators:start --rules firestore.rules.dev`.
// Production uses firestore.rules.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
