{
  "name": "@worktracker/api",
  "version": "0.1.0",
  "private": true,
  "description": "WorkTracker backend: REST API, MCP server, and the brain Firestore trigger.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:functions": "tsc -p tsconfig.functions.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@worktracker/types": "file:../../packages/types",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
