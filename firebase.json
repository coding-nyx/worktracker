{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "target": "default",
    "public": "web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/mcp",
        "run": {
          "serviceId": "worktracker-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp/v2",
        "run": {
          "serviceId": "worktracker-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp.md",
        "run": {
          "serviceId": "worktracker-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "worktracker-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/admin/boards",
        "destination": "/admin/boards.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/sources",
        "destination": "/sources.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
